vbox = {

	name = "event_window_widget_segrellion_daenerys_royal_tyranny"

	layoutpolicy_horizontal = expanding

	spacing = 4

	margin = { 12 6 }


	# =====================================================
	# HEADER
	# =====================================================

	hbox = {

		layoutpolicy_horizontal = expanding


		text_single = {

			text = "SEGRELLION_DAENERYS_ROYAL_TYRANNY_HEADER"

			align = left|nobaseline

			default_format = "#high"
		}


		expand = {}


		text_single = {

			text = "SEGRELLION_DAENERYS_ROYAL_TYRANNY_VALUE"

			align = right|nobaseline

			default_format = "#high"
		}
	}


	# =====================================================
	# ROYAL TYRANNY BAR
	#
	# 0   = reconciled realm
	# 100 = open rebellion
	# =====================================================

	progressbar_red = {

		name = "segrellion_daenerys_royal_tyranny_bar"

		layoutpolicy_horizontal = expanding

		size = { -1 20 }


		min = 0

		max = 100


		value = "[GetPlayer.MakeScope.Var( 'segrellion_daenerys_pacification_tyranny' ).GetValue]"


		using = Progressbar_Changed_Animation


		# =================================================
		# CURRENT VALUE MARKER
		# =================================================

		marker = {

			name = "current_value"


			widget = {

				icon = {

					size = { 25 25 }

					position = { -20 0 }

					texture = "gfx/interface/progressbars/progressbar_center_glow.dds"
				}
			}
		}
	}


	# =====================================================
	# SCALE
	# =====================================================

	hbox = {

		layoutpolicy_horizontal = expanding


		text_single = {

			text = "SEGRELLION_DAENERYS_ROYAL_TYRANNY_MIN"

			align = left|nobaseline

			default_format = "#low"
		}


		expand = {}


		text_single = {

			text = "SEGRELLION_DAENERYS_ROYAL_TYRANNY_MAX"

			align = right|nobaseline

			default_format = "#low"
		}
	}
}